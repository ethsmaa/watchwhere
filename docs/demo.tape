# vhs script — render with `vhs docs/demo.tape`

Output docs/demo.gif

Set FontFamily "Menlo"
Set FontSize 18
Set Width 1000
Set Height 600
Set Theme "TokyoNight"
Set TypingSpeed 40ms
Set Padding 30
Set LineHeight 1.4
Set Framerate 50
Set Shell "zsh"

# --- segment 1: add disney+ to subs ---
Type "ww subs"
Sleep 350ms
Enter
Sleep 1300ms

Down
Sleep 140ms
Down
Sleep 140ms
Down
Sleep 140ms
Space
Sleep 500ms
Enter
Sleep 1700ms

# --- segment 2: search star wars ---
Type "ww star wars"
Sleep 350ms
Enter
Sleep 1500ms

Down
Sleep 200ms
Up
Sleep 450ms
Enter
Sleep 3000ms
