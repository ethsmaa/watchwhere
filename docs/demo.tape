# vhs script — render with `vhs docs/demo.tape`

Output docs/demo.gif

Set FontFamily "Menlo"
Set FontSize 18
Set Width 1000
Set Height 600
Set Theme "TokyoNight"
Set TypingSpeed 55ms
Set Padding 30
Set LineHeight 1.4
Set Framerate 50
Set Shell "zsh"

# --- segment 1: add disney+ to subs ---
Type "ww subs"
Sleep 400ms
Enter
Sleep 1800ms

Down
Sleep 200ms
Down
Sleep 200ms
Down
Sleep 200ms
Down
Sleep 200ms
Space
Sleep 600ms
Enter
Sleep 2200ms

# --- segment 2: search star wars ---
Type "ww star wars"
Sleep 400ms
Enter
Sleep 1800ms

Down
Sleep 250ms
Up
Sleep 500ms
Enter
Sleep 3500ms
